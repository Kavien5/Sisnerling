# ============================================
# SISNERLING - Sistem Neraca Lingkungan
# Environment Configuration (Example)
# ============================================

# Server
PORT=3000

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sisnerling_db

# Bootstrap admin; set both values only for the first production startup.
# Use a unique, strong password and provide these through the hosting secret store.
SEED_SUPER_ADMIN_NAMA=Admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
